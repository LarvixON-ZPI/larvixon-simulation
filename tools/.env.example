# Absolute path to your Unity Editor executable
# UNITY_PATH="/home/you/Unity/Hub/Editor/6000.2.2f1/Editor/Unity"
UNITY_PATH="/absolute/path/to/Unity"

# Where to put builds
OUTPUT_DIR="${PWD}/Builds"

# Version subfolder for builds
BUILD_VERSION="1.0.0"

# Project path (defaults to repo root if unset)
PROJECT_PATH="${PWD}"

# Optional: additional Unity args (space separated)
# EXTRA_UNITY_ARGS="-nographics"

# Optional: C# static method instead of legacy CLI flags
# BUILD_METHOD="Company.Build.Perform"

# Optional: license credentials if needed in CI
# UNITY_SERIAL=""
# UNITY_USERNAME=""
# UNITY_PASSWORD=""
